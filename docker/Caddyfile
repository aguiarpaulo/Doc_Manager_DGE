# Terminacao HTTPS e origem unica para SPA + API (GAP-002).
#
# Com um {$CADDY_DOMAIN} real, o Caddy provisiona certificado Let's Encrypt
# automaticamente; em localhost emite um certificado interno autoassinado.
#
# Os dois lados do produto ficam sob a mesma origem, o que dispensa CORS por
# completo: nenhuma requisicao do navegador atravessa origens.
{$CADDY_DOMAIN} {
	encode gzip

	# `handle_path` remove o prefixo /api antes de repassar. A API monta seus
	# routers na raiz (/auth, /obras, /documents, /health), entao sem essa
	# remocao o caminho chegaria duplicado como /api/auth/login.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv

		# Os arquivos com hash no nome sao imutaveis; o index nunca e cacheado,
		# senao um deploy novo continuaria servindo o bundle antigo.
		@comHash path_regexp ^/assets/.*-[A-Za-z0-9_-]{8,}\.(js|css|woff2?)$
		header @comHash Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		# Fallback de SPA: acesso direto a uma rota filha e atualizacao do
		# navegador nela precisam devolver o index para o roteador resolver,
		# em vez de 404 do servidor de arquivos.
		try_files {path} /index.html
		file_server
	}
}
