# Copy to .env and fill in real secrets. Never commit .env.

# Database
POSTGRES_USER=ged
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ged

# MinIO (object storage). One pair of names for both sides: compose feeds these to the
# MinIO server as its root credentials, and every client (API in Docker, API running
# locally, smoke scripts) reads the same two variables.
GED_MINIO_ACCESS_KEY=ged-minio
GED_MINIO_SECRET_KEY=change-me-strong-minio-password
GED_MINIO_BUCKET=documents

# API
GED_JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-chars

# First administrator, created on startup only while no administrator exists.
# Leave blank to skip. Minimum 12 characters.
GED_BOOTSTRAP_ADMIN_USERNAME=admin
GED_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GED_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-admin-password

# HTTPS (GAP-002): set to your real domain in production; localhost for local TLS.
CADDY_DOMAIN=localhost

# E-mail / SMTP (password reset). Leave GED_SMTP_HOST empty for dev mode
# (reset tokens are logged, not e-mailed). Set it to enable real delivery via any
# provider (Amazon SES, SendGrid, Mailgun, Gmail, ...).
# GED_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# GED_SMTP_PORT=587
# GED_SMTP_USER=your-smtp-username
# GED_SMTP_PASSWORD=your-smtp-password
# GED_SMTP_FROM=nao-responda@empresa.com
# GED_SMTP_STARTTLS=true
# GED_RESET_URL_BASE=https://ged.empresa.com/reset-password

# Frontend (SPA). Injetadas no bundle em tempo de build e portanto publicas:
# nunca coloque segredo aqui. A SPA e a API compartilham a origem, e o Caddy
# remove o prefixo /api ao repassar para o backend.
VITE_BASE_PATH=/
VITE_API_BASE_URL=/api
