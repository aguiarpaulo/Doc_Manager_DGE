# Copy to .env and fill in real secrets. Never commit .env.

# Database
POSTGRES_USER=ged
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ged

# MinIO (object storage). One pair of names for both sides: compose feeds these to the
# MinIO server as its root credentials, and every client (API in Docker, API running
# locally, smoke scripts) reads the same two variables.
GED_MINIO_ACCESS_KEY=ged-minio
GED_MINIO_SECRET_KEY=change-me-strong-minio-password
GED_MINIO_BUCKET=documents

# API
GED_JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-chars

# First administrator, created on startup only while no administrator exists.
# Leave blank to skip. Minimum 12 characters.
GED_BOOTSTRAP_ADMIN_USERNAME=admin
GED_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GED_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-admin-password

# HTTPS (GAP-002): set to your real domain in production; localhost for local TLS.
CADDY_DOMAIN=localhost

# E-mail / SMTP (password reset, signature requests). Leave GED_SMTP_HOST empty for
# dev mode (reset tokens are logged, not e-mailed). Set it to enable real delivery
# via any provider. Example with Gmail: needs 2-Step Verification and an App
# Password (https://myaccount.google.com/apppasswords) — the normal account password
# is refused. GED_SMTP_FROM must be the same Gmail address, or Gmail rewrites it.
# Limit: ~500 recipients/day. On Oracle Cloud use 587: outbound port 25 is blocked.
# GED_SMTP_HOST=smtp.gmail.com
# GED_SMTP_PORT=587
# GED_SMTP_STARTTLS=true
# GED_SMTP_USER=voce@gmail.com
# GED_SMTP_PASSWORD=senha-de-app-de-16-caracteres
# GED_SMTP_FROM=voce@gmail.com

# Frontend (SPA). Injetadas no bundle em tempo de build e portanto publicas:
# nunca coloque segredo aqui. A SPA e a API compartilham a origem, e o Caddy
# remove o prefixo /api ao repassar para o backend.
VITE_BASE_PATH=/
VITE_API_BASE_URL=/api

# Base pública única para os links que a API coloca em e-mail (reset de senha e
# solicitação de assinatura). Obrigatória quando GED_SMTP_HOST está definido.
GED_APP_URL_BASE=https://ged.example.com

# Remetente. Obrigatório quando GED_SMTP_HOST está definido: com relay
# autenticado por IP (Google Workspace) não há GED_SMTP_USER para servir de
# fallback, e o cabeçalho From sairia em branco.
GED_SMTP_FROM=ged@example.com

# Origens autorizadas a chamar a API de outro endereço, separadas por vírgula.
# Deixe VAZIO em produção: o Caddy serve a SPA e a API na mesma origem, então não
# há chamada cruzada e liberar origem só ampliaria a superfície.
# Preencha apenas para desenvolvimento com o servidor do Vite, que roda noutra
# porta — sem isto o navegador barra toda requisição no preflight e a tela de
# login mostra falha de rede:
#   GED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GED_CORS_ORIGINS=
